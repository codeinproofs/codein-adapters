{
  "name": "@codein/adapters",
  "version": "0.1.0",
  "description": "Pluggable CodeIn adapters — OpenAI, pump.fun, Vercel — with deterministic mocks",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=18" },
  "keywords": ["codein", "adapters", "pump.fun", "openai", "vercel", "solana"],
  "author": "CodeIn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeinproofs/codein-adapters.git"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
